<?xml version="1.0" encoding="utf-8"?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)">
  <Profiles>
    <Profile Name="(Default)" />
  </Profiles>
  <Settings>
    <Setting Name="Language" Type="System.String" Scope="User"><Value Profile="(Default)">zh-CN</Value></Setting>
    <Setting Name="ScreenOffHotkey" Type="System.String" Scope="User"><Value Profile="(Default)">Ctrl+Alt+F10</Value></Setting>
    <Setting Name="AutomaticUpdateChecks" Type="System.Boolean" Scope="User"><Value Profile="(Default)">True</Value></Setting>
    <Setting Name="MigrationComplete" Type="System.Boolean" Scope="User"><Value Profile="(Default)">False</Value></Setting>
    <Setting Name="DisplayProfile" Type="System.String" Scope="User"><Value Profile="(Default)"></Value></Setting>
    <Setting Name="DisplayProfileCheckedUtc" Type="System.String" Scope="User"><Value Profile="(Default)"></Value></Setting>
    <Setting Name="CompletedDisplayProfile" Type="System.String" Scope="User"><Value Profile="(Default)"></Value></Setting>
    <Setting Name="SetupIntroShown" Type="System.Boolean" Scope="User"><Value Profile="(Default)">False</Value></Setting>
    <Setting Name="SetupLastNoticeKey" Type="System.String" Scope="User"><Value Profile="(Default)"></Value></Setting>
    <Setting Name="TimeoutMinutes" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">10</Value>
    </Setting>
  </Settings>
</SettingsFile>
