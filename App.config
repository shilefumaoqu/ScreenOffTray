<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Set owner/repo after the GitHub repository exists. Blank makes no request. -->
    <add key="GitHubRepository" value="" />
  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
